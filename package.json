{
  "name": "obs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "next build --webpack",
    "start": "NODE_ENV=production tsx server.ts",
    "test:remote": "node scripts/remote-smoke.mjs",
    "test:connection": "tsx --test scripts/remote-connection.test.ts scripts/remote-renewal.test.ts",
    "test:clocks": "tsx --test scripts/clock-sync.test.ts scripts/clock-relay.test.ts scripts/camera-clock.test.ts",
    "clock:reader": "bash local-clock/run.sh",
    "test:camera": "PYTHONPATH=local-clock local-clock/.venv/bin/python -m unittest discover -s local-clock/tests && tsx --test scripts/camera-relay.test.ts",
    "test:shortcuts": "node --import tsx --test scripts/shortcuts.test.ts",
    "test:basketball": "node --import tsx --test scripts/basketball-fouls.test.ts scripts/clock-input.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.1.6",
    "@types/crypto-js": "^4.2.2",
    "@vercel/functions": "3.7.1",
    "crypto-js": "^4.2.0",
    "ioredis": "5.11.1",
    "next": "16.2.9",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.3.5",
    "usehooks-ts": "^3.1.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.9",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
